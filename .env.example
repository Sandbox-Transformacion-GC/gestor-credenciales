# Copia este archivo a ".env" y completa con los datos de TU proyecto de Supabase
# (Project Settings -> API en el dashboard de Supabase).
#
# La "anon key" está diseñada para ser pública en el frontend: la seguridad real
# la da Row Level Security (RLS), configurado en supabase/schema.sql. NUNCA pongas
# aquí la "service_role key": esa sí es secreta y no debe usarse en el navegador.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY-PUBLICA
